# Copy to .env.local and adjust. Never commit real keys.

# Backend URL used by the Vite dev proxy for /api requests
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Satellite basemap tiles (XYZ template). Default: Esri World Imagery.
# Check the provider's terms of use before deploying publicly.
VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_SATELLITE_ATTRIBUTION=Tiles &copy; Esri &mdash; Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community

# Optional labels/streets overlay (leave empty to disable)
VITE_LABELS_TILE_URL=

# Approximate location fallback (IP lookup) used when the browser cannot give a position.
# Leave empty for the built-in key-less services, set to "off" to disable, or to your own https endpoint
# that returns JSON with latitude / longitude.
VITE_IP_GEO_URL=

# Copy to backend/.env and fill in. Never commit the real file.

# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# SQLite file (default: backend/ardna.db)
# DATABASE_URL=sqlite:///./ardna.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NASA Earthdata Login (needed only for the SMAP / IMERG ingestion scripts).
# These are the variable names read by earthaccess's "environment" strategy.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Alternatively an Earthdata user token:
# EARTHDATA_TOKEN=

# NASA POWER needs no key.
POWER_HISTORY_YEARS=15
# true = never call external services; use cache / demo data only
OFFLINE_MODE=false

# Where ingested SMAP / IMERG tables are stored
# DATA_STORE_DIR=./data_store

# Recommendation engine: rules | ml | hybrid
ENGINE=rules
# Path to the ML model file (used when ENGINE=ml or hybrid)
# MODEL_PATH=./app/ml/models/model.joblib

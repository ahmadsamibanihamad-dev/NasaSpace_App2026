# Copy to backend/.env and fill in. Never commit the real file.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left empty a random secret is created at every start (everyone is signed out on restart).
JWT_SECRET=

# SQLite database file (default: backend/ardna.db)
# DATABASE_URL=sqlite:///./ardna.db

# Web origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174

# NASA POWER needs no key.
POWER_HISTORY_YEARS=12
POWER_CACHE_HOURS=24
# true = never call external services; use cached data only
OFFLINE_MODE=false

# Requests per minute per client
RATE_LIMIT_AUTH=10
RATE_LIMIT_GUEST=12

# AI forecasting models:
#   off        no forecasts; recommendations use the historical climate record
#   mock       clearly labelled demonstration forecasts (for building the UI)
#   production real model files from MODEL_DIR; never falls back to mock
AI_MODE=off
# Folder with the model files and manifests/ (see app/ml/production.py)
# MODEL_DIR=./app/ml/artifacts
